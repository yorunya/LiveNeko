{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveNeko",
  "identifier": "com.liveneko.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiveNeko",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../prompt.md": "prompt.md",
      "../../spk": "spk",
      "../../model/SenseVoiceSmall/model.pt": "model/SenseVoiceSmall/model.pt",
      "../../model/SenseVoiceSmall/config.yaml": "model/SenseVoiceSmall/config.yaml",
      "../../model/SenseVoiceSmall/configuration.json": "model/SenseVoiceSmall/configuration.json",
      "../../model/SenseVoiceSmall/chn_jpn_yue_eng_ko_spectok.bpe.model": "model/SenseVoiceSmall/chn_jpn_yue_eng_ko_spectok.bpe.model",
      "../../model/SenseVoiceSmall/am.mvn": "model/SenseVoiceSmall/am.mvn",
      "../../model/fsmn-vad/model.pt": "model/fsmn-vad/model.pt",
      "../../model/fsmn-vad/config.yaml": "model/fsmn-vad/config.yaml",
      "../../model/fsmn-vad/configuration.json": "model/fsmn-vad/configuration.json",
      "../../model/fsmn-vad/am.mvn": "model/fsmn-vad/am.mvn",
      "../../model/cam++/campplus_cn_common.bin": "model/cam++/campplus_cn_common.bin",
      "../../model/cam++/config.yaml": "model/cam++/config.yaml",
      "../../model/cam++/configuration.json": "model/cam++/configuration.json",
      "../../DeepFilterNet/models/DeepFilterNet3_onnx.tar.gz": "model/DeepFilterNet3_onnx.tar.gz",
      "../scripts": "scripts"
    }
  }
}
